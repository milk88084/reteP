# ── Clerk ──────────────────────────────────────────────────────────
# Dashboard: https://dashboard.clerk.com → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 後端 API ────────────────────────────────────────────────────────
# 本機開發指向 FastAPI 後端；正式環境填 Zeabur 上的網址
VITE_API_BASE_URL=http://localhost:8000

# ── AI 食物辨識 (optional) ──────────────────────────────────────────
# n8n webhook or other AI service URL
VITE_AI_WEBHOOK_URL=https://your-n8n-instance.com/webhook/food-recognize

# ── Mock mode ──────────────────────────────────────────────────────
# Set to "true" to use mock data (no backend / AI calls needed)
VITE_USE_MOCK=false

# ── Google Analytics 4 (optional) ─────────────────────────────────
# GA4 Admin → Data streams → Measurement ID（形如 G-XXXXXXXXXX）。
# 留空則完全不載入 GA，也不會報錯。
VITE_GA_MEASUREMENT_ID=
